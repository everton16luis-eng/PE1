  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "inquirer": "^14.2.2",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "qrcode": "1.5.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "playwright-core": "1.63.0"
  }
}
