{
  "name": "igreja-novo-caminho---refatorado",
  "version": "1.0.0",
  "description": "",
  "main": "backend/src/server.js",
  "scripts": {
    "test": "node tests/preparar-banco.js && node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "dev": "nodemon backend/src/server.js",
    "start": "node backend/src/server.js",
    "db:presenca": "node backend/database/executar.js backend/database/presenca.sql",
    "db:paginas": "node backend/database/executar.js backend/database/paginas.sql",
    "db:seed": "node backend/database/seed.js && node backend/database/executar.js backend/database/seed-paginas.sql && node backend/database/seed-voluntarios.js",
    "db:setup": "npm run db:presenca && npm run db:paginas && npm run db:voluntario && npm run db:cadastro && npm run db:seed && npm run db:pessoas && npm run db:acesso && npm run db:relatorios && npm run db:trocas && npm run db:notificacoes && npm run db:atendimento",
    "test:seguranca": "node tests/preparar-banco.js && node --test tests/seguranca-acesso.test.js tests/sql-injection.test.js",
    "test:layout": "node tests/preparar-banco.js && node --test tests/layout.test.js",
    "db:voluntario": "node backend/database/executar.js backend/database/voluntario.sql",
    "db:cadastro": "node backend/database/executar.js backend/database/cadastro.sql",
    "db:pessoas": "node backend/database/executar.js backend/database/pessoas.sql",
    "db:acesso": "node backend/database/executar.js backend/database/acesso.sql",
    "db:relatorios": "node backend/database/executar.js backend/database/relatorios.sql",
    "db:trocas": "node backend/database/executar.js backend/database/trocas.sql",
    "db:notificacoes": "node backend/database/executar.js backend/database/notificacoes.sql",
    "db:atendimento": "node backend/database/executar.js backend/database/atendimento-turmas.sql",
    "db:instalar": "node backend/database/executar.js backend/database/instalacao.sql",
    "db:gerar-instalacao": "node backend/database/gerar-instalacao.js",
    "push:chaves": "node backend/database/gerar-chaves-push.js"
  },
  "keywords": [],
