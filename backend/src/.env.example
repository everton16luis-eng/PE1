PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=igreja_sistema

# Chave para assinar os tokens de login (gere uma aleatória)
AUTH_SECRET=troque_por_uma_chave_aleatoria

# Notificações no celular (Web Push): gere com  npm run push:chaves
# (grava as chaves aqui automaticamente; não troque depois de publicar)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@suaigreja.org

# Hora (no fuso da igreja) dos lembretes da véspera
LEMBRETE_HORA=18

# Opcionais
# Caminho do pg_dump (backup), se não estiver na instalação padrão do PostgreSQL
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# Pasta dos relatórios gerados (padrão: arquivos/ na raiz do projeto)
# PASTA_ARQUIVOS=
